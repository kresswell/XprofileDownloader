# Copy to .env and fill in. Never commit .env (already gitignored). chmod 600 .env
# X cookies (alternative to --cookies)
X_COOKIES_FILE=./cookies.txt

# Telegram mode: userbot | bot
TG_MODE=userbot
# Both modes need these (https://my.telegram.org):
TG_API_ID=
TG_API_HASH=
# Userbot session name (file <name>.session, gitignored). First run asks phone+code.
TG_SESSION=xscraper
# Bot mode only (from @BotFather):
TG_BOT_TOKEN=
# Upload destination: 'me' (userbot Saved Messages), @username, chat id, invite link.
# Note: bots cannot use 'me' - use a chat/channel id where the bot is admin/member.
TG_TARGET=me
